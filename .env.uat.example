# Copy to .env.uat on the homelab. Never commit it.
LAKEHOUSE_ENV=uat
LAKEHOUSE_IMAGE=ghcr.io/hoanghaithanh/sec-holdings-lakehouse:latest
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Each worker: 10 cores / 20 GB, split into two executors of 5 cores / 9 GB.
SPARK_WORKER_CORES=10
SPARK_WORKER_MEMORY=20g
SPARK_EXECUTOR_CORES=5
SPARK_EXECUTOR_MEMORY=9g

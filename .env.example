# Copy to .env for local dev. Never commit .env.
LAKEHOUSE_ENV=dev
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=change-me-at-least-8-chars
# SEC fair access: app name plus a contact email, e.g. "sec-lakehouse you@example.com".
SEC_USER_AGENT=
# Requests per second per run (1 to 10). 5 keeps two concurrent runs under SEC's 10/s.
SEC_MAX_REQUESTS_PER_SECOND=5
